rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isGrandfatheredMember() {
      return signedIn() && request.auth.token.email in [
        'victoriaolok@gmail.com',
        'wachaexperience@gmail.com'
      ];
    }

    function entitlementPath() {
      return /databases/$(database)/documents/memberEntitlements/$(request.auth.uid);
    }

    function hasActiveEntitlement() {
      return signedIn()
        && exists(entitlementPath())
        && (
          get(entitlementPath()).data.status == 'active' ||
          (
            get(entitlementPath()).data.status == 'trial' &&
            (
              !('renewalAt' in get(entitlementPath()).data) ||
              get(entitlementPath()).data.renewalAt > request.time
            )
          )
        );
    }

    function isCurrentMember() {
      return isGrandfatheredMember() || hasActiveEntitlement();
    }

    function isPublisher() {
      return signedIn() && request.auth.token.email in [
        'victoriaolok@gmail.com',
        'wachaexperience@gmail.com'
      ];
    }

    function isModerator() {
      return isPublisher();
    }

    match /memberEntitlements/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isPublisher());
      allow list: if isPublisher();

      allow create, update: if isPublisher()
        && request.resource.data.status in ['active', 'trial', 'cancelled', 'expired']
        && request.resource.data.role in ['member', 'publisher', 'moderator', 'admin'];

      allow delete: if isPublisher();
    }

    match /memberPrompts/{promptId} {
      allow get, list: if isPublisher() || (
        isCurrentMember() &&
        resource.data.publishAt is timestamp &&
        resource.data.publishAt <= request.time
      );

      allow create: if isPublisher()
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 120
        && request.resource.data.body is string
        && request.resource.data.body.size() > 0
        && request.resource.data.body.size() <= 2200;

      allow update, delete: if isPublisher();
    }

    match /communityPosts/{postId} {
      allow get, list: if isCurrentMember();

      allow create: if isCurrentMember()
        && request.resource.data.authorEmail == request.auth.token.email
        && request.resource.data.authorLabel is string
        && request.resource.data.authorLabel.size() > 0
        && request.resource.data.authorLabel.size() <= 80
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 120
        && request.resource.data.body is string
        && request.resource.data.body.size() > 0
        && request.resource.data.body.size() <= 2200
        && request.resource.data.category in [
          'Practical question',
          'Local knowledge',
          'Small win',
          'General support'
        ];

      allow update: if false;
      allow delete: if isModerator() || (
        isCurrentMember() && resource.data.authorEmail == request.auth.token.email
      );

      match /replies/{replyId} {
        allow get, list: if isCurrentMember();

        allow create: if isCurrentMember()
          && request.resource.data.authorEmail == request.auth.token.email
          && request.resource.data.authorLabel is string
          && request.resource.data.authorLabel.size() > 0
          && request.resource.data.authorLabel.size() <= 80
          && request.resource.data.body is string
          && request.resource.data.body.size() > 0
          && request.resource.data.body.size() <= 1200;

        allow update: if false;
        allow delete: if isModerator() || (
          isCurrentMember() && resource.data.authorEmail == request.auth.token.email
        );
      }
    }

    match /communityReports/{reportId} {
      allow create: if isCurrentMember()
        && request.resource.data.reportedBy == request.auth.token.email
        && request.resource.data.kind in ['post', 'reply']
        && request.resource.data.targetId is string
        && request.resource.data.postId is string
        && request.resource.data.status == 'open';

      allow get, list, delete: if isModerator();
      allow update: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
