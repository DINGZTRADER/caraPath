# Copy these names into Vercel for Preview and Production. Do not commit real values.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Paste the Firebase service-account JSON as one line. Keep it server-only.
FIREBASE_ADMIN_SERVICE_ACCOUNT_JSON=

# Comma-separated email addresses approved for the Carer’s Circle Member Area.
FIREBASE_MEMBER_EMAILS=

# Phase 2 only. Leave both values blank until the enquiry workflow, monitored
# inbox, privacy notice and safeguarding process are approved and implemented.
CLARA_PATH_ENQUIRY_EMAIL=
CLARA_PATH_ENQUIRY_ENDPOINT=
